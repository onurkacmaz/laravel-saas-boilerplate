APP_NAME="SaaS Boilerplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Base URL of your frontend, used in e-mails (invitations, password reset, verification...)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saas
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_STORE=redis  # Recommended for production (uncomment and use Redis)
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_LOGGER=null
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US
CASHIER_PATH=stripe
STRIPE_DEMO_PAYMENT_METHOD=pm_card_visa
# Used by the PlanSeeder to wire the paid plans to your Stripe prices
STRIPE_PRODUCT_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

VITE_APP_NAME="${APP_NAME}"

# Lifetime of API tokens issued on login, in minutes
AUTH_TOKEN_LIFETIME=3600
# Secret used to sign the short-lived 2FA challenge tokens (falls back to APP_KEY when empty)
JWT_SECRET=
JWT_TTL=5

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

ORGANIZATION_SETTINGS_DEFAULT_TIMEZONE=UTC
ORGANIZATION_SETTINGS_DEFAULT_LOCALE=en
ORGANIZATION_SETTINGS_DEFAULT_CURRENCY=USD
INVITATION_EXPIRE_DAYS=7

# Allow webhooks to target private/loopback addresses (local development only!)
WEBHOOKS_ALLOW_PRIVATE_URLS=false

AUDIT_ENABLED=true
GDPR_DELETION_GRACE_DAYS=30

# RabbitMQ (only used by the optional Sail container)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
